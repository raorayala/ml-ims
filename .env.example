# Database — SQLite (default, zero-cost local) or PostgreSQL
# SQLite:
DATABASE_URL="file:./dev.db"
# PostgreSQL (Docker / local):
# DATABASE_URL="postgresql://mlims:mlims@localhost:5432/mlims?schema=public"

# API
PORT=4000
API_BASE_URL="http://localhost:4000"
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000/api"

# Expiration quarantine uses the API host local calendar (not a lab timezone).
# Planned: LAB_TIMEZONE="America/Los_Angeles"
CRON_SCHEDULE="0 0 * * *"

# Auth (required for API login / JWT). Use a long random string in production.
# Web dashboard stores the JWT in localStorage (not HttpOnly cookies).
JWT_SECRET="dev-only-change-me-ml-ims-jwt"
JWT_EXPIRES_IN="12h"

# Agent (optional LLM — leave blank for rule-based NL parser only)
# Free local option: Ollama at http://localhost:11434
LLM_BASE_URL="http://localhost:11434/v1"
LLM_API_KEY="ollama"
LLM_MODEL="llama3.2"
AGENT_USE_LLM="false"

# Default acting user for agent CLI / MCP (free-text; not verified against users).
# Not used by the authenticated web API.
DEFAULT_USER_ID="lab-tech-001"
